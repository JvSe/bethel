enum PrayerStatus {
  PRAYING
  ANSWERED
}

model PrayerRequest {
  id        String       @id @default(uuid())
  familyId  String
  family    Organization @relation(fields: [familyId], references: [id], onDelete: Cascade)
  text      String
  status    PrayerStatus @default(PRAYING)
  authorId  String?
  author    User?        @relation("PrayerRequestAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([familyId])
  @@map("prayer_request")
}

model GratitudeEntry {
  id        String       @id @default(uuid())
  familyId  String
  family    Organization @relation(fields: [familyId], references: [id], onDelete: Cascade)
  text      String
  authorId  String?
  author    User?        @relation("GratitudeEntryAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  date      DateTime     @default(now())
  createdAt DateTime     @default(now())

  @@index([familyId])
  @@map("gratitude_entry")
}
