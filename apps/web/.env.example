# Copie este arquivo para apps/web/.env e preencha os valores.

# Runtime: no Neon, use a connection string COM pooler (a que tem "-pooler" no host).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/DATABASE?sslmode=require"

# Só para `pnpm db:migrate` / o build na Vercel. No Neon, a connection string SEM pooler.
# No computador, pode deixar em branco se DATABASE_URL já for o Postgres local.
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Endereço do site. No computador use http://localhost:3001
BETTER_AUTH_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3001"

# Texto longo e secreto (mínimo 32 caracteres). Gere em https://generate-secret.vercel.app/32
BETTER_AUTH_SECRET="cole-aqui-um-texto-longo-aleatorio"

# Obrigatório na internet. No computador pode ficar vazio (o link de senha aparece no terminal).
RESEND_API_KEY=""
EMAIL_FROM="Bethel <ola@seudominio.com>"
